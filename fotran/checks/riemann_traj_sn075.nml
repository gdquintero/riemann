! Exact Moebius error s_n(0.75) for n = 2, ..., 5120 (check of Proposition 4.1).
! Usage (from fotran/): ./riemann_traj checks/riemann_traj_sn075.nml  ->  checks/traj_sn075/
&params
  alphas   = 0.75, 63*-1.0,
  n_start  = 2,
  n_step   = 1,
  nmax     = 5120,
  mmax     = 10000000,
  m0       = 10000,
  h        = 1e-3,
  cap      = 32768,
  nthreads = 4,
  out_dir  = 'checks/traj_sn075'
/
